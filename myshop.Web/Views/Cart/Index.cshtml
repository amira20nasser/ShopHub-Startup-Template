@model List<CartItem>

@{
    ViewBag.PageTitle = "Shopping Cart";
    ViewBag.CardTitle = "Your Cart";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-card {
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        border: 1px solid rgba(160,173,186,.35);
        box-shadow: 0 15px 35px rgba(0,0,0,.12);
        padding: 28px;
        animation: fadeIn .4s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .custom-card-title {
        background: linear-gradient(135deg,#1e3a8a,#3b82f6);
        padding: 18px;
        border-radius: 14px;
        margin-bottom: 22px;
        text-align: center;
        color: white;
        font-weight: 700;
        letter-spacing: .6px;
        font-size: 22px;
        box-shadow: 0 4px 20px rgba(30,58,138,.35);
    }

    .cart-item {
        display: flex;
        align-items: center;
        padding: 16px;
        margin-bottom: 14px;
        background: white;
        border-radius: 12px;
        border: 1px solid #e3e8ef;
        transition: .25s ease;
    }

        .cart-item:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,.08);
            transform: translateY(-1px);
        }

    .cart-item-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #d0d7de;
        margin-right: 18px;
        flex-shrink: 0;
    }

    .cart-item-info {
        flex: 1;
    }

    .cart-item-name {
        font-weight: 600;
        color: #1e3a8a;
        font-size: 16px;
        margin-bottom: 4px;
    }

    .cart-item-price {
        color: #6b7280;
        font-size: 14px;
    }

    .cart-item-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .qty-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid #d0d7de;
        background: #f8fafc;
        color: #1e3a8a;
        font-weight: 700;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: .2s;
    }

        .qty-btn:hover {
            background: #1e40af;
            color: white;
            border-color: #1e40af;
        }

    .qty-value {
        font-weight: 700;
        font-size: 16px;
        color: #1e3a8a;
        min-width: 28px;
        text-align: center;
    }

    .cart-item-total {
        font-weight: 700;
        color: #16a34a;
        font-size: 16px;
        min-width: 90px;
        text-align: right;
    }

    .remove-btn {
        background: none;
        border: none;
        color: #dc2626;
        font-size: 18px;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        transition: .2s;
    }

        .remove-btn:hover {
            background: #fef2f2;
        }

    .cart-summary {
        background: linear-gradient(135deg,#1e3a8a,#2563eb);
        border-radius: 14px;
        padding: 24px;
        color: white;
        margin-top: 20px;
    }

    .cart-total-label {
        font-size: 18px;
        font-weight: 600;
    }

    .cart-total-value {
        font-size: 28px;
        font-weight: 700;
    }

    .btn-clear {
        background: #dc2626;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        transition: .25s;
    }

        .btn-clear:hover {
            background: #b91c1c;
            transform: translateY(-2px);
        }

    .empty-cart {
        text-align: center;
        padding: 50px 20px;
        color: #6b7280;
    }

        .empty-cart i {
            font-size: 60px;
            color: #d0d7de;
            margin-bottom: 16px;
        }

        .empty-cart h5 {
            color: #1e3a8a;
            font-weight: 600;
        }

    .btn-continue {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg,#1e40af,#2563eb);
        color: white;
        text-decoration: none;
        display: inline-block;
        transition: .25s;
    }

        .btn-continue:hover {
            background: linear-gradient(135deg,#1e3a8a,#1d4ed8);
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }
</style>

<div class="custom-card">

    <div class="custom-card-title">
        <i class="fa-solid fa-cart-shopping me-2"></i>
        Shopping Cart
    </div>

    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            var itemTotal = item.Price * item.Quantity;
            var imgSrc = !string.IsNullOrEmpty(item.ImageUrl)
                ? Url.Content("~/" + item.ImageUrl)
                : Url.Content("~/img/default-150x150.png");

            <div class="cart-item">
                <img src="@imgSrc" class="cart-item-img" alt="@item.ProductName" />

                <div class="cart-item-info">
                    <div class="cart-item-name">@item.ProductName</div>
                    <div class="cart-item-price">@item.Price.ToString("C") each</div>
                </div>

                <div class="cart-item-actions">
                    <form asp-action="DecreaseQuantity" asp-route-productId="@item.ProductId" method="post" style="display:inline;">
                        <button type="submit" class="qty-btn">-</button>
                    </form>

                    <span class="qty-value">@item.Quantity</span>

                    <form asp-action="IncreaseQuantity" asp-route-productId="@item.ProductId" method="post" style="display:inline;">
                        <button type="submit" class="qty-btn">+</button>
                    </form>
                </div>

                <div class="cart-item-total">@itemTotal.ToString("C")</div>

                <form asp-action="Remove" asp-route-productId="@item.ProductId" method="post" style="display:inline;">
                    <button type="submit" class="remove-btn" title="Remove item">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </form>
            </div>
        }

        var orderTotal = Model.Sum(i => i.Price * i.Quantity);

        <div class="cart-summary d-flex justify-content-between align-items-center">
            <div>
                <div class="cart-total-label">Order Total</div>
            </div>
            <div class="cart-total-value">@orderTotal.ToString("C")</div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a asp-controller="Product" asp-action="Index" class="btn-continue">
                <i class="fa-solid fa-arrow-left me-1"></i> Continue Shopping
            </a>

            <form asp-action="Clear" method="post" style="display:inline;">
                <button type="submit" class="btn-clear">
                    <i class="fa-solid fa-trash me-1"></i> Clear Cart
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <i class="fa-solid fa-cart-shopping"></i>
            <h5>Your cart is empty</h5>
            <p class="mt-2">Browse products and add items to your cart.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-continue mt-3">
                <i class="fa-solid fa-shopping-bag me-1"></i> Start Shopping
            </a>
        </div>
    }

</div>
