@model PagedUsersDto
@using System.Security.Claims

@{
    ViewBag.PageTitle = "Users Management";
    ViewBag.CardTitle = "View Users";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="row mb-3">
    <div class="col-12">
        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
            <input type="text"
                   name="Search"
                   value="@Model.Search"
                   class="form-control w-50"
                   placeholder="Search by name or email..." />
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-secondary">Reset</a>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <table class="table table-bordered table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Lock Status</th>
                    <th style="width:320px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var isCurrentUser = user.Id == User.FindFirstValue(ClaimTypes.NameIdentifier);
                    var isAdmin = user.Roles.Contains("Admin");

                    <tr class="@(user.IsLocked ? "table-danger" : "")">
                        <td>
                            @user.Name
                            @if (isCurrentUser)
                            {
                                <span class="badge bg-info">You</span>
                            }
                        </td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge @(isAdmin ? "bg-danger" : "bg-primary")">
                                @(isAdmin ? "Admin" : "Customer")
                            </span>
                        </td>
                        <td>
                            @if (user.IsLocked)
                            {
                                <span class="badge bg-danger">Locked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @if (!isCurrentUser)
                                {
                                    @if (isAdmin)
                                    {
                                        <form asp-action="DemoteToCustomer" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('Demote @user.Name to Customer?');">
                                            <button type="submit" class="btn btn-warning btn-sm">
                                                <i class="fa-solid fa-user-minus"></i> Demote
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="PromoteToAdmin" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('Promote @user.Name to Admin?');">
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fa-solid fa-user-shield"></i> Promote
                                            </button>
                                        </form>
                                    }

                                    @if (user.IsLocked)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post">
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fa-solid fa-lock-open"></i> Unlock
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Lock" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('Lock @user.Name?');">
                                            <button type="submit" class="btn btn-secondary btn-sm">
                                                <i class="fa-solid fa-lock"></i> Lock
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No users found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row align-items-center">
    <div class="col-md-6">
        <p class="text-muted mb-0">
            Showing @Model.Users.Count of @Model.TotalCount user(s)
        </p>
    </div>
    <div class="col-md-6">
        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-pagenumber="@(Model.PageNumber - 1)">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-pagenumber="@p">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-pagenumber="@(Model.PageNumber + 1)">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
