@{
    ViewBag.PageTitle = "Products Management";
    ViewBag.CardTitle = "View Products";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-card {
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        border: 1px solid rgba(160,173,186,.35);
        box-shadow: 0 15px 35px rgba(0,0,0,.12);
        padding: 28px;
        animation: fadeIn .4s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .custom-card-title {
        background: linear-gradient(135deg,#1e3a8a,#3b82f6);
        padding: 18px;
        border-radius: 14px;
        margin-bottom: 22px;
        text-align: center;
        color: white;
        font-weight: 700;
        letter-spacing: .6px;
        font-size: 22px;
        box-shadow: 0 4px 20px rgba(30,58,138,.35);
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
    }

    .search-sort {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .search-box {
        position: relative;
    }

        .search-box input {
            padding: 10px 14px 10px 38px;
            border: 1px solid #d0d7de;
            border-radius: 10px;
            font-size: 14px;
            width: 260px;
            background: white;
            transition: .25s;
        }

            .search-box input:focus {
                border-color: #1e40af;
                box-shadow: 0 0 0 0.2rem rgba(59,130,246,0.2);
                outline: none;
            }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

    .sort-select {
        padding: 10px 14px;
        border: 1px solid #d0d7de;
        border-radius: 10px;
        font-size: 14px;
        background: white;
        color: #1e3a8a;
        font-weight: 500;
        cursor: pointer;
    }

        .sort-select:focus {
            border-color: #1e40af;
            box-shadow: 0 0 0 0.2rem rgba(59,130,246,0.2);
            outline: none;
        }

    .btn-primary {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg,#1e40af,#2563eb);
        color: white;
        box-shadow: 0 6px 20px rgba(37,99,235,.35);
        text-decoration: none;
        display: inline-block;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg,#1e3a8a,#1d4ed8);
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

    #productTable {
        width: 100%;
        border-collapse: collapse;
    }

        #productTable thead th {
            background: #1e40af !important;
            color: white !important;
            padding: 14px !important;
            border: none !important;
            cursor: default;
        }

        #productTable tbody td {
            background: white !important;
            padding: 14px !important;
            color: #1e3a8a;
            border-bottom: 1px solid #e3e8ef !important;
        }

        #productTable tbody tr:hover td {
            background: #ebf2ff !important;
        }

    .btn-success {
        background: #16a34a;
        color: white;
        border: none;
    }

    .btn-danger {
        background: #dc2626;
        color: white;
        border: none;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        margin-top: 20px;
    }

        .pagination button {
            padding: 8px 14px;
            border: 1px solid #d0d7de;
            border-radius: 8px;
            background: white;
            color: #1e3a8a;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: .2s;
        }

            .pagination button:hover:not(:disabled):not(.active) {
                background: #ebf2ff;
                border-color: #1e40af;
            }

            .pagination button.active {
                background: #1e40af;
                color: white;
                border-color: #1e40af;
            }

            .pagination button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    .page-info {
        text-align: center;
        color: #6b7280;
        font-size: 14px;
        margin-top: 10px;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #6b7280;
    }

        .empty-state i {
            font-size: 48px;
            color: #d0d7de;
            margin-bottom: 12px;
        }
</style>

<div class="custom-card">

    <div class="custom-card-title">
        <i class="fa-solid fa-box-open me-2"></i>
        Products List
    </div>

    <div class="top-bar">
        <div class="search-sort">
            <div class="search-box">
                <i class="fa-solid fa-search"></i>
                <input type="text" id="searchInput" placeholder="Search by name or description..." />
            </div>
            <select id="sortSelect" class="sort-select">
                <option value="name_asc">Name (A-Z)</option>
                <option value="name_desc">Name (Z-A)</option>
                <option value="price_asc">Price (Low to High)</option>
                <option value="price_desc">Price (High to Low)</option>
            </select>
        </div>
        <a asp-controller="Product" asp-action="Create" class="btn-primary">
            <i class="fa-solid fa-circle-plus me-1"></i> Create Product
        </a>
    </div>

    <table id="productTable" class="display table-hover" width="100%">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th style="width:130px;">Actions</th>
            </tr>
        </thead>
        <tbody id="productBody"></tbody>
    </table>

    <div id="emptyState" class="empty-state" style="display:none;">
        <i class="fa-solid fa-box-open"></i>
        <h5>No products found</h5>
    </div>

    <div class="pagination" id="pagination"></div>
    <div class="page-info" id="pageInfo"></div>

</div>

@section Scripts {
    <script src="~/js/products.js"></script>
}
