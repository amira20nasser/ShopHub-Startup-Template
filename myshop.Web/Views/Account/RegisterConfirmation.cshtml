@{
    ViewData["Title"] = "Confirm your email";
    var email = ViewData["Email"] as string;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="row justify-content-center text-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                <i class="fa-solid fa-envelope-circle-check fa-3x text-primary mb-3"></i>
                <h2 class="mb-3">Confirm your email</h2>
                <p class="text-muted">
                    A confirmation link has been sent to <strong>@email</strong>.
                    Please check your inbox and click the link to activate your account before signing in.
                </p>

                <a asp-action="Login" class="btn btn-outline-primary mt-3">Back to Login</a>
            </div>
        </div>
    </div>
</div>
